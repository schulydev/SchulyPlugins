<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.9.0</Version>
    <Description>Microsoft 365 for students via SchulyMicrosoft. Links a Microsoft account with a browser sign-in (stored as a Schuly linked account) and reads mail, calendar, OneDrive files and Teams chats (rich send, files, GIFs, chat pictures, scheduled messages).</Description>
    <Authors>schulydev</Authors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Schuly.Plugin.Abstractions" Version="0.10.*" />
  </ItemGroup>

</Project>
